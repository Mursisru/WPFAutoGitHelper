<Window x:Class="WpfAutoGitHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WpfAutoGitHelper.Views"
        Language="{Binding SpellCheckLanguageTag, ConverterCulture=en-US}"
        Style="{StaticResource AppWindowStyle}"
        KeyDown="OnWindowKeyDown"
        Title="{Binding Ui.AppTitle}"
        Height="740" Width="980" MinHeight="500" MinWidth="680">
    <Grid Margin="14">
        <Grid x:Name="MainContentGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppHeaderPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="4" Background="{DynamicResource BrushAccent}"
                        CornerRadius="2" Margin="0,4,14,4"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource HeaderTitleStyle}" Text="{Binding Ui.AppTitle}"/>
                    <TextBlock Style="{StaticResource HeaderSubtitleStyle}" Text="{Binding Ui.AppSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Style="{StaticResource BiosModeSegmentHostStyle}"
                            ToolTip="{Binding Ui.UiModeToggleTip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="UiModeHeader"
                                         Style="{StaticResource BiosModeSegmentLeftStyle}"
                                         Content="{Binding Ui.UiModeEasy}"
                                         IsChecked="{Binding IsEasyMode, Mode=TwoWay}"/>
                            <RadioButton Grid.Column="1" GroupName="UiModeHeader"
                                         Style="{StaticResource BiosModeSegmentMiddleStyle}"
                                         Content="{Binding Ui.UiModeAdvanced}"
                                         IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"/>
                            <RadioButton Grid.Column="2" GroupName="UiModeHeader"
                                         Style="{StaticResource BiosModeSegmentRightStyle}"
                                         Content="{Binding Ui.UiModeAutoAdvanced}"
                                         IsChecked="{Binding IsAutoAdvancedMode, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="F7" FontSize="10" Foreground="{DynamicResource BrushMuted}"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource StatusBarPanelStyle}">
            <WrapPanel VerticalAlignment="Center">
                <Border Style="{StaticResource BranchBadgeStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource BrushMuted}" FontSize="12"
                                   Text="{Binding Ui.RepoCurrentBranch}" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"
                                   Text="{Binding CurrentBranch}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BranchBadgeStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource BrushMuted}" FontSize="12"
                                   Text="{Binding Ui.RepoSelectedProject}" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"
                                   Text="{Binding SelectedProjectName}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BranchBadgeStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource BrushMuted}" FontSize="12"
                                   Text="{Binding Ui.RepoSelectedFolder}" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"
                                   Text="{Binding SelectedProjectFolder}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Foreground="{DynamicResource BrushMuted}" FontSize="12"
                           Text="{Binding BusyText}" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <TabControl x:Name="EzTabControl" Grid.Row="2" Style="{StaticResource MainTabControlStyle}"
                    Visibility="{Binding IsEasyMode, Converter={StaticResource BoolToVis}}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- 1. Actions workflow -->
            <TabItem x:Name="ActionsTab" Header="{Binding Ui.TabActions}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4">

                        <!-- Step 1: project folder -->
                        <GroupBox Style="{StaticResource CardGroupStyle}" Header="{Binding Ui.Step1Repo}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{Binding Ui.RepoHint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           FontWeight="Normal"/>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,4"
                                          IsEditable="True"
                                          Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding RecentRepoPaths}"
                                          ToolTip="{Binding Ui.RepoPathTip}"
                                          ContextMenu="{StaticResource RepoPathContextMenu}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding Ui.HintEzRepoPath}"
                                           Visibility="{Binding ShowFieldHints, Converter={StaticResource BoolToVis}}"/>
                                <WrapPanel Style="{StaticResource ToolbarWrapPanelStyle}">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding Ui.BtnCreateNewRepo}" Command="{Binding CreateNewRepoCommand}"
                                            ToolTip="{Binding Ui.TipCreateNewRepo}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnBrowse}" Command="{Binding BrowseRepoCommand}"
                                            ToolTip="{Binding Ui.TipBrowse}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnSaveRepo}" Command="{Binding SaveRepoCommand}"
                                            ToolTip="{Binding Ui.TipSaveRepo}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnOpenFolder}" Command="{Binding OpenFolderCommand}"
                                            ToolTip="{Binding Ui.TipOpenFolder}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnOpenGitHub}" Command="{Binding OpenGitHubCommand}"
                                            ToolTip="{Binding Ui.TipOpenGitHub}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnConfigureOrigin}" Command="{Binding ConfigureOriginCommand}"
                                            ToolTip="{Binding Ui.TipConfigureOrigin}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Step 2: choose action (local work) -->
                        <GroupBox Style="{StaticResource CardGroupStyle}" Header="{Binding Ui.Step2Actions}">
                            <StackPanel>
                                <WrapPanel Style="{StaticResource ToolbarWrapPanelStyle}">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding Ui.BtnPull}" Command="{Binding PullCommand}"
                                            ToolTip="{Binding Ui.TipPull}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnStatus}" Command="{Binding RefreshStatusCommand}"
                                            ToolTip="{Binding Ui.TipStatus}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnDiff}" Command="{Binding DiffCommand}"
                                            ToolTip="{Binding Ui.TipDiff}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnAddAll}" Command="{Binding AddAllCommand}"
                                            ToolTip="{Binding Ui.TipAddAll}"/>
                                </WrapPanel>
                                <Expander Header="{Binding Ui.ActionsHelpHeader}" IsExpanded="False" Margin="0,8,0,0">
                                    <Border Style="{DynamicResource HelpPanelStyle}" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Ui.HelpWorkflowPrep}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushText}" FontSize="12" LineHeight="20"/>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </GroupBox>

                        <!-- Step 3: branches -->
                        <GroupBox Style="{StaticResource CardGroupStyle}" Header="{Binding Ui.Step3Branches}">
                            <StackPanel>
                                <Expander Header="{Binding Ui.BranchesHelpHeader}" IsExpanded="False" Margin="0,0,0,10">
                                    <Border Style="{DynamicResource HelpPanelStyle}" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Ui.BranchesExplain}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushText}" FontSize="12" LineHeight="20"/>
                                    </Border>
                                </Expander>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0"
                                             Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Ui.BranchesNewTip}"/>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding Ui.BtnCreateBranch}" Command="{Binding CreateBranchCommand}"
                                            ToolTip="{Binding Ui.TipCreateBranch}" MinWidth="88"/>
                                </Grid>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,6"
                                          ItemsSource="{Binding Branches}"
                                          SelectedItem="{Binding SelectedBranch}"
                                          ToolTip="{Binding Ui.BranchesListTip}"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnCheckout}" Command="{Binding CheckoutBranchCommand}"
                                            ToolTip="{Binding Ui.TipCheckout}" MinWidth="110"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnPushBranch}" Command="{Binding PushBranchCommand}"
                                            ToolTip="{Binding Ui.TipPushBranch}" MinWidth="110"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Step 4: commit & publish -->
                        <GroupBox Style="{StaticResource CardGroupStyle}" Header="{Binding Ui.Step4Publish}">
                            <StackPanel>
                                <TextBlock Text="{Binding Ui.PublishHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushMuted}" FontSize="11.5" Margin="0,0,0,12" LineHeight="18"/>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.CommitHeader}"/>
                                <TextBox Style="{StaticResource InputTextBoxSpellStyle}"
                                         Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="72" MaxHeight="140"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,4"
                                         ContextMenu="{StaticResource TextEditContextMenu}"/>
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding Ui.HintEzCommitMessage}"
                                           Visibility="{Binding ShowFieldHints, Converter={StaticResource BoolToVis}}"/>
                                <WrapPanel Style="{StaticResource ToolbarWrapPanelStyle}">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding Ui.BtnSyncGitHub}" Command="{Binding SyncToGitHubCommand}"
                                            ToolTip="{Binding Ui.TipSyncGitHub}"/>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding Ui.BtnCommit}" Command="{Binding CommitCommand}"
                                            ToolTip="{Binding Ui.TipCommit}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding Ui.BtnPush}" Command="{Binding PushCommand}"
                                            ToolTip="{Binding Ui.TipPush}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <Separator Margin="0,12,0,12"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Ui.BtnClearWorkflow}" Command="{Binding ClearWorkflowCommand}"
                                ToolTip="{Binding Ui.TipClearWorkflow}" MinWidth="120"
                                HorizontalAlignment="Left"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Releases -->
            <TabItem x:Name="ReleasesTab" Header="{Binding Ui.TabReleases}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <GroupBox Style="{StaticResource CardGroupStyle}" Header="{Binding Ui.ReleasesHeader}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Ui.ReleasesHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushMuted}" FontSize="11.5" Margin="0,0,0,14" LineHeight="18"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.ReleaseTag}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"
                                     Text="{Binding ReleaseTag, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.ReleaseTitle}"/>
                            <TextBox Style="{StaticResource InputTextBoxSpellStyle}" Margin="0,0,0,10"
                                     Text="{Binding ReleaseTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.ReleaseNotes}"/>
                            <TextBox Style="{StaticResource InputTextBoxSpellStyle}" Margin="0,0,0,10"
                                     Text="{Binding ReleaseNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="96" MaxHeight="180"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.ReleaseTarget}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"
                                     Text="{Binding ReleaseTargetBranch, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="{Binding Ui.ReleaseLatest}" Margin="0,0,0,6"
                                      IsChecked="{Binding ReleaseLatest}"/>
                            <CheckBox Content="{Binding Ui.ReleasePrerelease}" Margin="0,0,0,12"
                                      IsChecked="{Binding ReleasePrerelease}"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.ReleaseAssets}" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding Ui.ReleaseAssetsHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushMuted}" FontSize="11" Margin="0,0,0,6"/>
                            <ListBox x:Name="EzReleaseAssetsList"
                                     Style="{StaticResource AppListBoxStyle}"
                                     MinHeight="72" MaxHeight="140" Margin="0,0,0,8"
                                     ItemsSource="{Binding ReleaseAssets}"
                                     SelectedItem="{Binding SelectedReleaseAsset}"
                                     ToolTip="{Binding Ui.TipReleaseAssetsList}"
                                     ContextMenu="{StaticResource ReleaseAssetsContextMenu}"
                                     PreviewMouseRightButtonDown="OnListBoxPreviewMouseRightButtonDown"/>
                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding Ui.TipReleaseAssetsContextMenu}" Margin="0,0,0,8"
                                       Visibility="{Binding ShowFieldHints, Converter={StaticResource BoolToVis}}"/>
                            <WrapPanel Style="{StaticResource ToolbarWrapPanelStyle}" Margin="0,0,0,12">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Ui.BtnReleaseAddFiles}" Command="{Binding AddReleaseAssetsCommand}"
                                        ToolTip="{Binding Ui.TipReleaseAddFiles}"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Ui.BtnReleaseAddImages}" Command="{Binding AddReleaseImagesCommand}"
                                        ToolTip="{Binding Ui.TipReleaseAddImages}"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Ui.BtnReleaseAddBuild}" Command="{Binding AddReleaseBuildOutputCommand}"
                                        ToolTip="{Binding Ui.TipReleaseAddBuild}"/>
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource ToolbarWrapPanelStyle}">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding Ui.BtnCreateRelease}" Command="{Binding CreateReleaseCommand}"
                                        ToolTip="{Binding Ui.TipCreateRelease}"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Ui.BtnOpenReleases}" Command="{Binding OpenReleasesCommand}"
                                        ToolTip="{Binding Ui.TipOpenReleases}"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Git identity (global only) -->
            <TabItem x:Name="IdentityTab" Header="{Binding Ui.TabIdentity}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <GroupBox Style="{StaticResource CardGroupStyle}" Header="{Binding Ui.IdentityHeader}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Ui.IdentityGlobalHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushMuted}" FontSize="11.5" Margin="0,0,0,14" LineHeight="18"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.IdentityUserName}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12"
                                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.IdentityUserEmail}"/>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14"
                                     Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding Ui.BtnApplyConfig}" Command="{Binding ApplyGitConfigCommand}"
                                        ToolTip="{Binding Ui.TipApplyConfig}" MinWidth="110"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Ui.BtnLoadConfig}" Command="{Binding LoadGitConfigCommand}"
                                        ToolTip="{Binding Ui.TipLoadConfig}" MinWidth="110"/>
                            </WrapPanel>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding Ui.BtnClearIdentity}" Command="{Binding ClearIdentityCommand}"
                                    ToolTip="{Binding Ui.TipClearIdentity}" MinWidth="200"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- 4. Log -->
            <TabItem x:Name="LogTab" Header="{Binding Ui.TabLog}">
                <Border Style="{StaticResource LogPanelChromeStyle}" Margin="4">
                    <TextBox Style="{StaticResource LogTextBoxStyle}"
                             Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             ContextMenu="{StaticResource LogContextMenu}"/>
                </Border>
            </TabItem>

            <!-- 5. Settings -->
            <TabItem x:Name="SettingsTab" Header="{Binding Ui.TabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource SettingsPanelStyle}" Margin="4">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource BrushHeader}"
                                       Text="{Binding Ui.SettingsHeader}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                    <ColumnDefinition Width="*" MaxWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"
                                           Foreground="{DynamicResource BrushMuted}" Text="{Binding Ui.SettingsLanguage}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"
                                          IsEditable="False" Margin="0,0,0,10"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource BrushText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"
                                           Foreground="{DynamicResource BrushMuted}" Text="{Binding Ui.SettingsTheme}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"
                                          IsEditable="False" Margin="0,0,0,10"
                                          ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource BrushText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10"
                                           Foreground="{DynamicResource BrushMuted}" Text="{Binding Ui.SettingsBackgroundColor}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"
                                          IsEditable="False" Margin="0,0,0,10"
                                          ItemsSource="{Binding BackgroundColors}"
                                          SelectedItem="{Binding SelectedBackground, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource BrushText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{DynamicResource BrushMuted}" Text="{Binding Ui.SettingsAccentColor}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"
                                          IsEditable="False"
                                          ItemsSource="{Binding AccentColors}"
                                          SelectedItem="{Binding SelectedAccent, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource BrushText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <CheckBox Content="{Binding Ui.SettingsConfirmCommit}" Margin="0,0,0,8"
                                      IsChecked="{Binding ConfirmCommit}"/>
                            <CheckBox Content="{Binding Ui.SettingsShowFieldHints}" Margin="0,0,0,8"
                                      IsChecked="{Binding ShowFieldHints}"/>
                            <CheckBox Content="{Binding Ui.SettingsAutoRefresh}" Margin="0,0,0,8"
                                      IsChecked="{Binding AutoRefreshOnSaveRepo}"/>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Ui.SettingsDefaultUiMode}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding Ui.SettingsDefaultUiModeHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <RadioButton GroupName="DefaultUiModeEz" Content="{Binding Ui.UiModeEasy}"
                                         IsChecked="{Binding DefaultUiModeIsEasy, Mode=TwoWay}" Margin="0,0,0,4"/>
                            <RadioButton GroupName="DefaultUiModeEz" Content="{Binding Ui.UiModeAdvanced}"
                                         IsChecked="{Binding DefaultUiModeIsAdvanced, Mode=TwoWay}" Margin="0,0,0,4"/>
                            <RadioButton GroupName="DefaultUiModeEz" Content="{Binding Ui.UiModeAutoAdvanced}"
                                         IsChecked="{Binding DefaultUiModeIsAutoAdvanced, Mode=TwoWay}" Margin="0,0,0,12"/>
                            <TextBlock Foreground="{DynamicResource BrushMuted}" FontSize="11" TextWrapping="Wrap"
                                       Text="{Binding Ui.SettingsAutoSaveHint}" Margin="0,0,0,12"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding Ui.BtnClearLog}"
                                    Command="{Binding ClearLogCommand}" MinWidth="120"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <views:AdvancedModeView Grid.Row="2"
                                Visibility="{Binding IsAnyAdvancedMode, Converter={StaticResource BoolToVis}}"
                                DataContext="{Binding}"/>

        <Grid Panel.ZIndex="20"
              Grid.RowSpan="3"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource AppDialogScrimStyle}"/>
            <Border Style="{StaticResource AppDialogPanelStyle}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="24" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource HeaderTitleStyle}"
                               FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding DialogMessage}" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource BrushText}" Margin="0,0,0,12"/>
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding DialogInputText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"
                             Visibility="{Binding DialogShowInput, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Ui.BtnDialogCancel}" MinWidth="88" Margin="0,0,8,0"
                                Command="{Binding DialogCancelCommand}" IsCancel="True"
                                Visibility="{Binding DialogShowInput, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding Ui.BtnDialogNo}" MinWidth="88" Margin="0,0,8,0"
                                Command="{Binding DialogNoCommand}" IsCancel="True"
                                Visibility="{Binding DialogShowYesNo, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding Ui.BtnDialogYes}" MinWidth="88" Margin="0,0,8,0"
                                Command="{Binding DialogYesCommand}" IsDefault="True"
                                Visibility="{Binding DialogShowYesNo, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding Ui.BtnDialogOk}" MinWidth="88"
                                Command="{Binding DialogOkCommand}" IsDefault="True"
                                Visibility="{Binding DialogShowOkOnly, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding Ui.BtnDialogOk}" MinWidth="88"
                                Command="{Binding DialogOkCommand}" IsDefault="True"
                                Visibility="{Binding DialogShowInput, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
