<Window x:Class="WpfAutoGitHelper.Views.FatalErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="WPF Auto Git Helper"
        Width="680" Height="420"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource HeaderTitleStyle}"
                   Text="{Binding TitleText}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" Style="{StaticResource LogTextBoxStyle}"
                 Text="{Binding ErrorText, Mode=OneWay}" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                Content="{Binding OkText}" IsDefault="True" MinWidth="96"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="Ok_Click"/>
    </Grid>
</Window>
