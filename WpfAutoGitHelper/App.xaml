<Application x:Class="WpfAutoGitHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter xmlns:converters="clr-namespace:WpfAutoGitHelper.Converters" x:Key="InverseBoolToVis"/>
            <converters:InverseBoolConverter xmlns:converters="clr-namespace:WpfAutoGitHelper.Converters" x:Key="InverseBool"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
