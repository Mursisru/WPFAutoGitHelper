<Window x:Class="WpfAutoGitHelper.Views.ConflictResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialogWindowStyle}"
        Title="Resolve conflict"
        Height="520" Width="900" MinHeight="400" MinWidth="720">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding FilePath}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource BrushMuted}"/>
        <GroupBox Grid.Row="1" Header="Base (ancestor)" Style="{StaticResource CardGroupStyle}" Margin="0,0,0,6">
            <TextBox Style="{StaticResource LogTextBoxStyle}" Text="{Binding BaseText, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Ours (current)" Style="{StaticResource CardGroupStyle}" Margin="0,0,0,6">
            <TextBox Style="{StaticResource LogTextBoxStyle}" Text="{Binding OursText, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="Theirs (incoming)" Style="{StaticResource CardGroupStyle}" Margin="0,0,0,10">
            <TextBox Style="{StaticResource LogTextBoxStyle}" Text="{Binding TheirsText, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Accept ours" MinWidth="100" Margin="0,0,8,0"
                    Click="OnAcceptOurs"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Accept theirs" MinWidth="100" Margin="0,0,8,0"
                    Click="OnAcceptTheirs"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Accept both" MinWidth="100" Margin="0,0,8,0"
                    Click="OnAcceptBoth"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save" MinWidth="88" Margin="0,0,8,0"
                    Click="OnSave" IsDefault="True"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" MinWidth="88"
                    Click="OnCancel" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
