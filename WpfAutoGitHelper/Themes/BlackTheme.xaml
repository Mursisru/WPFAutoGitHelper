<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorAccent">#A78BFA</Color>
    <Color x:Key="ColorAccentHover">#C4B5FD</Color>
    <Color x:Key="ColorBg">#000000</Color>
    <Color x:Key="ColorSurface">#0A0A0A</Color>
    <Color x:Key="ColorCardBg">#121212</Color>
    <Color x:Key="ColorBorder">#2E2E2E</Color>
    <Color x:Key="ColorText">#F5F5F5</Color>
    <Color x:Key="ColorMuted">#A3A3A3</Color>
    <Color x:Key="ColorHeader">#FFFFFF</Color>
    <Color x:Key="ColorTabInactive">#0F0F0F</Color>
    <Color x:Key="ColorTabHover">#1F1F1F</Color>
    <Color x:Key="ColorTabSelected">#161616</Color>
    <Color x:Key="ColorAccentSoft">#1E1B2E</Color>
    <Color x:Key="ColorInputBg">#0A0A0A</Color>
    <Color x:Key="ColorInputFg">#F5F5F5</Color>
    <Color x:Key="ColorSecondaryBtn">#1A1A1A</Color>
    <Color x:Key="ColorSecondaryBtnHover">#2A2A2A</Color>
    <Color x:Key="ColorHelpPanelBg">#101010</Color>
    <Color x:Key="ColorHelpPanelBorder">#2E2E2E</Color>

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}"/>
    <SolidColorBrush x:Key="BrushHeader" Color="{StaticResource ColorHeader}"/>
    <SolidColorBrush x:Key="BrushTabInactive" Color="{StaticResource ColorTabInactive}"/>
    <SolidColorBrush x:Key="BrushTabHover" Color="{StaticResource ColorTabHover}"/>
    <SolidColorBrush x:Key="BrushTabSelected" Color="{StaticResource ColorTabSelected}"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}"/>
    <SolidColorBrush x:Key="BrushInputBg" Color="{StaticResource ColorInputBg}"/>
    <SolidColorBrush x:Key="BrushInputFg" Color="{StaticResource ColorInputFg}"/>
    <SolidColorBrush x:Key="BrushSecondaryBtn" Color="{StaticResource ColorSecondaryBtn}"/>
    <SolidColorBrush x:Key="BrushSecondaryBtnHover" Color="{StaticResource ColorSecondaryBtnHover}"/>
    <SolidColorBrush x:Key="BrushSegmentHost" Color="{StaticResource ColorTabInactive}"/>
    <SolidColorBrush x:Key="BrushSegmentSelectedFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushMenuBg" Color="{StaticResource ColorCardBg}"/>
    <SolidColorBrush x:Key="BrushMenuBorder" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushMenuHover" Color="{StaticResource ColorTabHover}"/>
    <Color x:Key="ColorLogBg">#050505</Color>
    <Color x:Key="ColorLogFg">#E5E5E5</Color>
    <SolidColorBrush x:Key="BrushLogBg" Color="{StaticResource ColorLogBg}"/>
    <SolidColorBrush x:Key="BrushLogFg" Color="{StaticResource ColorLogFg}"/>
    <SolidColorBrush x:Key="BrushLogBorder" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushHelpPanelBg" Color="{StaticResource ColorHelpPanelBg}"/>
    <SolidColorBrush x:Key="BrushHelpPanelBorder" Color="{StaticResource ColorHelpPanelBorder}"/>
    <SolidColorBrush x:Key="BrushScrollTrack" Color="#141414"/>
    <SolidColorBrush x:Key="BrushScrollThumb" Color="#404040"/>
    <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#5A5A5A"/>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeChrome.xaml"/>
        <ResourceDictionary Source="InputControls.xaml"/>
        <ResourceDictionary Source="AppContextMenus.xaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
